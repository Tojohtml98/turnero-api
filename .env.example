PORT=3001
MONGODB_URI=mongodb://localhost:27017/turnero
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
CORS_ORIGIN=https://your-app.vercel.app

# Admin sembrado por `npm run seed` (unico usuario, no hay registro publico)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@turnero.local
ADMIN_PASSWORD=change_me_in_production

# Nombre del negocio (mostrado en emails y respuestas)
BUSINESS_NAME=Mi Negocio

# SMTP opcional: sin configurar, el sistema funciona igual y solo loguea
# que no se pudo enviar el email (nunca rompe la reserva).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Turnero <no-reply@turnero.local>

# Hora (0-23) en la que corre el recordatorio diario de "manana tenes turno"
REMINDER_CRON_HOUR=18
