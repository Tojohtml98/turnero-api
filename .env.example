PORT=3001
MONGODB_URI=mongodb://localhost:27017/turnero
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
CORS_ORIGIN=https://your-app.vercel.app

# Admin sembrado por `npm run seed` (unico usuario, no hay registro publico)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@turnero.local
ADMIN_PASSWORD=change_me_in_production

# Nombre del negocio (mostrado en emails y respuestas)
BUSINESS_NAME=Mi Negocio

# SMTP opcional: sin configurar, el sistema funciona igual y solo loguea
# que no se pudo enviar el email (nunca rompe la reserva).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Turnero <no-reply@turnero.local>

# Hora (0-23) en la que corre el recordatorio diario de "manana tenes turno"
REMINDER_CRON_HOUR=18

# ---------------------------------------------------------------------------
# Booking por lenguaje natural (POST /api/intents/parse)
# ---------------------------------------------------------------------------
# Motor de parseo. Intercambiable sin tocar codigo:
#   rules  (default) deterministico, sin red ni IA. Es el que usan los tests.
#   ollama           modelo local. Recomendado para produccion con IA.
#   nim              NVIDIA NIM. SOLO DEV, ver abajo.
#   auto             ollama -> nim -> rules, segun lo que este configurado.
INTENT_PARSER=rules
INTENT_TIMEOUT_MS=8000

# Ollama local: sin OLLAMA_URL, el modo `auto` lo saltea.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# NVIDIA NIM — SOLO DESARROLLO.
# Las NVIDIA API Trial Terms of Service (1.2 y 1.4) prohiben usar el free tier
# en produccion, y 3.3 permite a NVIDIA entrenar con lo que se le manda. El
# parser se niega a arrancar con NODE_ENV=production. No pasar por aca mensajes
# de clientes reales.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
